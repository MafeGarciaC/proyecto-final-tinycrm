# Cliente A — se usa junto con el .env de la raíz:
#   docker compose --env-file .env --env-file apps/cliente-a.env -f apps/docker-compose.yml -p tiny-a up -d
CLIENTE=A
CLIENTE_MIN=a

# Base de datos de este cliente (dentro del clúster Galera, a través del LB BD)
DB_NAME=tinycrm_a
DB_USER=app_a
DB_PASSWORD=clave_a_2026

# Usuarios iniciales (no se pueden repetir entre clientes)
TINY_ADMIN_USERNAME=admin_a
TINY_ADMIN_EMAIL=admin@cliente-a.com
TINY_SUPPORT_USERNAME=support_a
TINY_SUPPORT_EMAIL=support@cliente-a.com

# IPs. Diagrama: LB Cliente A 192.168.1.6, Cluster App A 192.168.1.3 / 192.168.2.3
LB_IP=10.1.1.6
APP1_DMZ_IP=10.1.1.31
APP1_INT_IP=10.1.2.31
APP2_DMZ_IP=10.1.1.32
APP2_INT_IP=10.1.2.32
WEB1_IP=10.1.1.33
WEB2_IP=10.1.1.34

# Puerto publicado del LB (solo para pruebas; en la versión final se entra por el middleware)
LB_PORT=8101
