# Cliente B — se usa junto con el .env de la raíz:
#   docker compose --env-file .env --env-file apps/cliente-b.env -f apps/docker-compose.yml -p tiny-b up -d
CLIENTE=B
CLIENTE_MIN=b

# Base de datos de este cliente (dentro del clúster Galera, a través del LB BD)
DB_NAME=tinycrm_b
DB_USER=app_b
DB_PASSWORD=clave_b_2026

# Usuarios iniciales (no se pueden repetir entre clientes)
TINY_ADMIN_USERNAME=admin_b
TINY_ADMIN_EMAIL=admin@cliente-b.com
TINY_SUPPORT_USERNAME=support_b
TINY_SUPPORT_EMAIL=support@cliente-b.com

# IPs. Diagrama: LB Cliente B 192.168.1.7, Cluster App B 192.168.1.4 / 192.168.2.4
LB_IP=10.1.1.7
APP1_DMZ_IP=10.1.1.41
APP1_INT_IP=10.1.2.41
APP2_DMZ_IP=10.1.1.42
APP2_INT_IP=10.1.2.42
WEB1_IP=10.1.1.43
WEB2_IP=10.1.1.44

# Puerto publicado del LB (solo para pruebas; en la versión final se entra por el middleware)
LB_PORT=8102
