# Variables compartidas por todos los docker compose del proyecto.
# Los scripts de scripts/ copian este archivo a .env si no existe.
# Son contraseñas de laboratorio: no usar en un sistema real.

# --- Clúster de base de datos (MariaDB Galera) ---
DB_ROOT_PASSWORD=root_tiny_2026

# Una base y un usuario por cliente (aislamiento)
DB_A_NAME=tinycrm_a
DB_A_USER=app_a
DB_A_PASSWORD=clave_a_2026
DB_B_NAME=tinycrm_b
DB_B_USER=app_b
DB_B_PASSWORD=clave_b_2026

# Publicadores de eventos (outbox) de cada cliente
DB_A_OUTBOX_PASSWORD=clave_outbox_a_2026
DB_B_OUTBOX_PASSWORD=clave_outbox_b_2026

# --- Puertos publicados en la máquina ---
ADMINER_PORT=8090

# --- BD Usuarios (componente central) ---
USUARIOS_DB_ROOT_PASSWORD=root_usuarios_2026
USUARIOS_MIDDLEWARE_PASSWORD=clave_middleware_2026
USUARIOS_CONSUMER_PASSWORD=clave_consumer_2026

# --- Middleware ---
# Firma la cookie que recuerda a qué cliente pertenece el navegador (evita que la cambien a mano)
MIDDLEWARE_SECRETO=cambia_este_secreto_2026
MIDDLEWARE_PORT=80

# --- Broker de mensajería (RabbitMQ) ---
RABBIT_USER=tiny
RABBIT_PASSWORD=clave_rabbit_2026
RABBIT_ADMIN_PORT=15672

# --- DNS ---
# IP de la Máquina #1 en la red de la casa/universidad (la que devuelve www.tiny.com).
# Revisarla antes de la sustentación: si el DHCP la cambia hay que actualizarla aquí.
IP_MAQUINA1=192.168.1.100
# 53 en la VM Ubuntu. En Windows el puerto 53 lo ocupa el sistema: usar 1053.
DNS_PORT=53
